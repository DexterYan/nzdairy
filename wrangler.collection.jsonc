{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milkcompass-collector",
  "main": "workers/collection/index.ts",
  "compatibility_date": "2026-09-01",
  // The collector serves no HTTP routes; keep any accidental route off too.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "milkcompass-snapshots"
    }
  ]
}
